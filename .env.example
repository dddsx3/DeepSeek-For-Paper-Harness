# DeepSeek-For-Paper-Harness 环境变量示例
# 用法：复制本文件为 .env（同目录），填入真实值后保存。.env / .env.* 已被
# .gitignore 忽略（.env.example 除外），不会进入版本库。

# 【必填】DeepSeek API 密钥。在 https://platform.deepseek.com 创建。
# 真实 API 测试（pnpm run test:e2e）、demo 与写作层执行器都从这里读取。
DEEPSEEK_API_KEY=

# 【可选】DeepSeek API 基础地址；默认使用官方端点。自建代理或中转时才需要修改。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【可选】产品用户数据根目录；默认为 ~/.dph（设置、凭据、会话、profile 都在其下）。
# 仅当需要把数据放到其他位置时才设置。与官方 dsh 的 ~/.dsh 完全隔离。
# DPH_HOME=

# ---------------------------------------------------------------------------
# TASK-T1 Sprint 2 — 探针/实测路由（PAPER_PROBE_* 中立变量族，P3D）。
# 只服务 Track 2（能力探针）与 Track 3（用户实测）；CI 永远 fake/replay，
# key 绝不进 CI。第二模型族（中转路由）接入样例：
#   PAPER_PROBE_API_KEY=<中转密钥>
#   PAPER_PROBE_BASE_URL=https://api.tokenrouter.com/v1
#   PAPER_PROBE_MODEL=z-ai/glm-5.3-free
#   PAPER_PROBE_PROVIDER=openai-compatible-relay
# 严并发纪律：real-provider.ts 内置进程级信号量（默认上限 1，即严格串行）
# + 429/5xx 指数退避（最多 4 次尝试）。并发上限可通过下面变量放宽，
# 但仅当探针批次已实测确认额度与并发余量后才允许调高：
#   PAPER_PROBE_MAX_CONCURRENCY=1
# ---------------------------------------------------------------------------
