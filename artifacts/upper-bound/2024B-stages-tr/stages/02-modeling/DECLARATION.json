  "equations": [
    {"id": "EQ-01", "statement": "Q_v=(prod pi_u)(1-p_v)", "meaning": "输入全合格与装配不引入次品同时成立", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-02", "statement": "a_i=x_i(c_i+d_i)/(1-p_i)+(1-x_i)c_i", "meaning": "零配件i到装配点的有效单位成本", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-03", "statement": "pi_i=x_i+(1-x_i)(1-p_i)", "meaning": "零配件i到装配点的合格概率", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-04", "statement": "B_new=sum(a_u)+g_v+x_v d_v", "meaning": "首轮含新购件的单轮装配成本", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-05", "statement": "B_rec=sum(x_u d_u)+g_v+x_v d_v", "meaning": "回收件轮次的单轮装配成本", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-06", "statement": "K_rec=[B_rec+(1-Q)((1-y)w+s)]/Q", "meaning": "自回收件起点至合格成品的期望成本", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-07", "statement": "K_new=B_new+(1-Q)((1-y)w+s+K_rec)", "meaning": "拆解分支下的总期望成本", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-08", "statement": "K_new=[B_new+(1-Q)(1-y)w]/Q", "meaning": "报废分支下的总期望成本", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-09", "statement": "Pi=S-K_new", "meaning": "单件期望利润", "problem_refs": ["Q2", "Q3", "Q4"], "shared": true},
    {"id": "EQ-10", "statement": "x_v=1则a_v=K_new；x_v=0则a_v=B_new,pi_v=Q_v", "meaning": "节点向上级输出的成本与合格率算子", "problem_refs": ["Q3"], "shared": false},
    {"id": "EQ-11", "statement": "P(X=k)=C(n,k)p^k(1-p)^(n-k)", "meaning": "二项抽样概率", "problem_refs": ["Q1", "Q4"], "shared": true},
    {"id": "EQ-12", "statement": "P(X>=c|p_nom)<=0.05", "meaning": "情形(1)95%信度拒收判据", "problem_refs": ["Q1"], "shared": false},
    {"id": "EQ-13", "statement": "P(X<=c-1|p_nom)>=0.90", "meaning": "情形(2)90%信度接收判据", "problem_refs": ["Q1"], "shared": false},
    {"id": "EQ-14", "statement": "P(X>=c|p_1)>=0.90", "meaning": "情形(1)功效约束", "problem_refs": ["Q1"], "shared": false},
    {"id": "EQ-15", "statement": "P(X<=c-1|p_1)<=0.10", "meaning": "情形(2)使用方风险约束", "problem_refs": ["Q1"], "shared": false},
    {"id": "EQ-16", "statement": "n*=min{n:存在c同时满足两约束}", "meaning": "最小样本量准则", "problem_refs": ["Q1"], "shared": false},
    {"id": "EQ-17", "statement": "T=1/Q", "meaning": "产出一件合格成品的期望装配轮数", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-18", "statement": "K_new=购买+检测+装配+拆解+调换", "meaning": "成本分项恒等式，用于模型自检", "problem_refs": ["Q2", "Q3"], "shared": true},
    {"id": "EQ-19", "statement": "p|X~Beta(X+1,n-X+1)", "meaning": "问题4次品率的后验分布", "problem_refs": ["Q4"], "shared": false},
    {"id": "EQ-20", "statement": "keep_rate=Pr(strategy is argmax over posterior)", "meaning": "后验下的决策保持率与期望后悔", "problem_refs": ["Q4"], "shared": false}
  ],
