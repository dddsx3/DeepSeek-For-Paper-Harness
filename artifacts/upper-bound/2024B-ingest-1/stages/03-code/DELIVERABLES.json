    },
    {
      "path": "code/main.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "编排入口；按问题一至问题四顺序同步执行，并写出各问题 JSON 与汇总 outputs.json。"
    },
    {
      "path": "code/problem1.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
