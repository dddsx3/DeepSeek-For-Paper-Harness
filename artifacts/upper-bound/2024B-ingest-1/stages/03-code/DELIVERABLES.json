  "artifacts": [
    {"kind": "code", "path": "code/main.py", "min_bytes": 500, "desc": "编排入口：依次跑问题1~4与灵敏度扫描，把全部结果写进 code/outputs.json"},
    {"kind": "code", "path": "code/constants.py", "min_bytes": 1, "desc": "模型常数（按 DECLARATION model_constants 键名）与题面给定值（表1、表2）登记表"},
    {"kind": "code", "path": "code/numeric.py", "min_bytes": 1, "desc": "二项尾概率表与 Beta 分位数数值工具，无第三方依赖"},
    {"kind": "code", "path": "code/problem1.py", "min_bytes": 1, "desc": "问题1：单侧二项检验两点设计 + 整数样本量最小化搜索；情形(2)主答案取单侧置信上界口径"},
    {"kind": "code", "path": "code/problem2.py", "min_bytes": 1, "desc": "问题2：16 组合全枚举 + 期望利润闭式 + 分项成本分解"},
    {"kind": "code", "path": "code/problem3.py", "min_bytes": 1, "desc": "问题3：装配树节点级 DP（自底向上聚合 U/Q、帕累托前沿剪枝）+ 拓扑扰动扫描"},
    {"kind": "code", "path": "code/problem4.py", "min_bytes": 1, "desc": "问题4：表1 全部六种情形 + 问题3 装配树的 Clopper-Pearson 区间、固定决策利润区间与蒙特卡洛一致率"},
    {"kind": "code", "path": "code/sensitivity.py", "min_bytes": 1, "desc": "灵敏度扫描：±扰动重解、盈亏平衡二维网格、逐链蒙特卡洛校验"},
    {"kind": "output", "path": "code/outputs.json", "min_bytes": 1024, "desc": "全部结果锚点的机器可读账本，由 python code/main.py 真跑生成"},
    {"kind": "doc", "path": "RESULTS.md", "min_bytes": 1024, "desc": "结果说明：四问结构、校核证据、归因与诚实边界"}
  ],
