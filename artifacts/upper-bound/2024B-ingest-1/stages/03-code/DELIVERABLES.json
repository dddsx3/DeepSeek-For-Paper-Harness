{
  "deliverables": [
    {
      "path": "code/",
      "kind": "dir",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "逐问实现目录，包含 problem1.py、problem2.py、problem3.py、problem4.py，并由 params.py 提供集中参数。"
    },
    {
      "path": "code/main.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "四问同步编排入口，依次执行各问、核验结果并将完整结果写入 code/outputs.json。"
    },
    {
      "path": "code/params.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "集中参数与题面事实展开模块，统一提供 Q2Case、主替拓扑、Q1 风险网格和 Q4 情景抽样常数。"
    },
    {
      "path": "code/problem1.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "问题一实现：精确二项整数枚举、拒收与接收方案、灵敏度扫描及有限 SPRT 对照。"
    },
    {
      "path": "code/problem2.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "问题二实现：兼容扁平 Q2Case 字段，枚举 16 种策略并用吸收状态方程和事件现金流账本求解。"
    },
    {
      "path": "code/problem3.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "问题三实现：支持一般 DAG 的节点级检测与处置决策，运行主拓扑和替代拓扑条件情景并执行退化一致性核验。"
    },
    {
      "path": "code/problem4.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "问题四实现：情景抽样、Clopper–Pearson 端点分支、Bonferroni 联合域、稳健重解和固定种子蒙特卡洛。"
    },
    {
      "path": "RESULTS.md",
      "kind": "md",
      "min_rows": 1,
      "min_bytes": 1024,
      "desc": "由实际运行账本生成的结果说明，涵盖四问关键结果、核验证据、策略归因、灵敏度及情景数据边界。"
    },
    {
      "path": "code/outputs.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "代码运行时生成的结果账本，包含四问标量、策略表、数据序列、情景样本和验证结果。"
    },
    {
      "path": "DELIVERABLES.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 1024,
      "desc": "阶段产出清单及可供下一阶段取数的 ledger_keys 映射。"
    }
  ],
