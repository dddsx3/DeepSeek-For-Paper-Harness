{
  "schema_version": "3.0",
  "stage": "03-code",
  "deliverables": [
    {
      "path": "code/",
      "kind": "dir",
      "min_rows": 6,
      "min_bytes": 1,
      "desc": "逐问源码目录，包含参数契约、四个 problem 模块和编排入口；代码文件数不少于题面问数。"
    },
    {
      "path": "code/params.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "题面事实、模型常数和证据边界参数契约；Q2 使用 price1/test1/price2/test2 规范字段，图1与实际抽样缺失均显式登记。"
    },
    {
      "path": "code/problem1.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题一实现：稳定精确二项枚举、整数阈值搜索、OC 数据、灵敏度序列和有限 SPRT 随机游走；精确 PMF 使用对数域计算以避免整数转浮点溢出。"
    },
    {
      "path": "code/problem2.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题二实现：兼容 Q2Case 扁平字段，枚举十六种策略，以明确吸收交付状态求解 Bellman 方程，并执行事件现金流、吸收性和成本单调性核验。"
    },
    {
      "path": "code/problem3.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题三实现：一般 DAG 节点规格、主替条件拓扑、完整失败处置、Q 与 C 同轨迹计算及 U=C/Q 单位核验；正式图1缺失时与条件情景结果隔离。"
    },
    {
      "path": "code/problem4.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题四实现：情景样本账本、逐节点精度样本量、Clopper-Pearson 边界分支、Bonferroni 联合域、Jeffreys 重抽样和逐情景重新 argmax；所有输出保留 scenario-only 标识。"
    },
    {
      "path": "code/main.py",
      "kind": "py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "编排入口：按问题一至问题四顺序同步执行，落盘逐问结果、汇总结果、运行摘要和 Q4 情景轨迹，并在写出前执行四问成功汇总断言。"
    },
    {
      "path": "code/outputs.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 1024,
      "runtime_generated": true,
      "desc": "四问统一结果账本，包含标量结果、完整候选策略、参数扫描序列、网络对照、样本轨迹摘要和核验状态。"
    },
    {
      "path": "code/problem1_results.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 512,
      "runtime_generated": true,
      "desc": "问题一独立结果文件，含精确二项方案、OC 序列、样本量曲线、SPRT 对照及设计常数灵敏度结果。"
    },
    {
      "path": "code/problem2_results.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 512,
      "runtime_generated": true,
      "desc": "问题二独立结果文件，含六种情形、十六策略完整对照、吸收状态价值、事件账本及灵敏度和盈亏平衡序列。"
    },
    {
      "path": "code/problem3_results.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 512,
      "runtime_generated": true,
      "desc": "问题三独立结果文件，含正式实例缺口状态、主替条件情景、网络和策略序列、单位成本及退化等价核验。"
    },
    {
      "path": "code/problem4_results.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 512,
      "runtime_generated": true,
      "desc": "问题四独立结果文件，含六种 Q2 情形与 Q3 条件情景的点策略、稳健策略、利润包络、样本量扫描和决策一致率。"
    },
    {
      "path": "code/run_summary.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 256,
      "runtime_generated": true,
      "desc": "四问前台同步运行摘要、成功标志、关键容差、证据边界和退化核验汇总。"
    },
    {
      "path": "code/q4_scenario_samples.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 1024,
      "runtime_generated": true,
      "desc": "问题四按固定随机种子生成并保存的逐参数 n_v、x_v、p_hat 情景样本账本；不是企业实际观测。"
    },
    {
      "path": "code/q4_jeffreys_draws.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 1024,
      "runtime_generated": true,
      "desc": "问题四基于情景计数生成的 Jeffreys 后验参数与重抽样轨迹，供决策一致率和稳健重解复核。"
    },
    {
      "path": "RESULTS.md",
      "kind": "md",
      "min_rows": 1,
      "min_bytes": 1024,
      "desc": "四问真实执行结果说明，引用统一 JSON 账本中的数值，并报告现金流、退化、CP 端点、联合置信构造和证据边界核验。"
    },
    {
      "path": "DELIVERABLES.json",
      "kind": "json",
      "min_rows": 1,
      "min_bytes": 1024,
      "desc": "阶段产物及阶段四取数键的机器可校验清单。"
    }
  ],
