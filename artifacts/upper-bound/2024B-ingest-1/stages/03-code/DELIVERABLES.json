{
  "format_version": 1,
  "stage": "03-code",
  "deliverables": [
    {
      "kind": "py",
      "path": "code/params.py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "题面事实、建模设计常数、网络拓扑、抽样设计及跨问题容差的统一参数入口。"
    },
    {
      "kind": "py",
      "path": "code/main.py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "按问题一至问题四顺序同步执行求解器，并将完整结构化结果写入 outputs.json。"
    },
    {
      "kind": "py",
      "path": "code/problem1.py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题一实现：精确二项整数枚举、题面约束方案、登记风险参数下的功效约束方案、OC 数据及有限 SPRT 对照。"
    },
    {
      "kind": "py",
      "path": "code/problem2.py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题二实现：枚举十六种策略，按检测、采购、装配、调换、报废和拆解事件求解单位最终合格交付利润。"
    },
    {
      "kind": "py",
      "path": "code/problem3.py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题三实现：对主、替代条件拓扑求解节点策略与单位指标，并执行问题二退化网络等价核验；不将推断拓扑冒充缺失原图的认证结果。"
    },
    {
      "kind": "py",
      "path": "code/problem4.py",
      "min_rows": 1,
      "min_bytes": 500,
      "desc": "问题四实现：逐节点情景样本、Clopper-Pearson 端点分支、Bonferroni 联合域、点估计重优化、稳健重解和可复现蒙特卡洛账本。"
    },
    {
      "kind": "dir",
      "path": "code/",
      "min_rows": 4,
      "min_bytes": 1,
      "min_files": 4,
      "file_glob": "problem*.py",
      "desc": "逐问实现目录，problem1.py 至 problem4.py 与题面四问一一对应。"
    },
    {
      "kind": "md",
      "path": "RESULTS.md",
      "min_rows": 1,
      "min_bytes": 1024,
      "desc": "由真实执行账本形成的结果说明，报告关键策略、利润、区间、敏感性、收敛序列、核验误差、失败阻断和条件分析边界。"
    },
    {
      "kind": "json",
      "path": "code/outputs.json",
      "min_rows": 1,
      "min_bytes": 1,
      "desc": "main.py 真跑后生成的唯一规范结果账本，包含 problem1 至 problem4 的全部标量、结构化数组、样本账本和核验结果。"
    },
    {
      "kind": "json",
      "path": "DELIVERABLES.json",
      "min_rows": 1,
      "min_bytes": 1024,
      "desc": "阶段产出清单及阶段四取数所需的 ledger_keys 唯一映射。"
    }
  ],
