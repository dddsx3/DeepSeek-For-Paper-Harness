{"stage":"02-modeling","problem":"2024高教社杯B题：生产过程中的决策问题","conventions":{"shared_rule":"跨子问题引用的条目标shared=true；problem_refs指向阶段1需求锚点R-Q1..R-Q4"},"symbols":[{"id":"SYM-P0","symbol":"p_0","meaning":"次品率标称值","shared":true},{"id":"SYM-GAMMA","symbol":"gamma","meaning":"信度水平1-alpha","shared":true},{"id":"SYM-N","symbol":"n","meaning":"抽样样本量","shared":true},{"id":"SYM-K","symbol":"k","meaning":"判定阈值","shared":false},{"id":"SYM-X","symbol":"X","meaning":"样本次品数","shared":false},{"id":"SYM-PI","symbol":"p_i","meaning":"零配件i次品率","shared":true},{"id":"SYM-PA","symbol":"p_a","meaning":"正品输入装配次品率","shared":true},{"id":"SYM-QI","symbol":"q_i","meaning":"有效输入次品率","shared":true},{"id":"SYM-PF","symbol":"p_f","meaning":"输出全口径次品率","shared":true},{"id":"SYM-XV","symbol":"x_v","meaning":"节点检测0-1决策","shared":true},{"id":"SYM-YV","symbol":"y_v","meaning":"节点拆解0-1决策","shared":true},{"id":"SYM-CI","symbol":"c_i","meaning":"购买单价元每件","shared":true},{"id":"SYM-DI","symbol":"d_i","meaning":"检测成本元每件","shared":true},{"id":"SYM-CA","symbol":"c_a","meaning":"装配成本元每件","shared":true},{"id":"SYM-S","symbol":"s","meaning":"市场售价元每件","shared":true},{"id":"SYM-L","symbol":"L","meaning":"调换损失元每件","shared":true},{"id":"SYM-DD","symbol":"d_d","meaning":"拆解费用元每件","shared":true},{"id":"SYM-PROFIT","symbol":"pi","meaning":"单位期望利润元每件","shared":true},{"id":"SYM-INT","symbol":"[p_L,p_U]","meaning":"次品率置信区间","shared":false},{"id":"SYM-RHO","symbol":"rho","meaning":"拆解回路压缩比","shared":true}],"assumptions":[{"id":"ASM-001","statement":"批内独立，X~B(n,p)，正态仅辅助","source":"A-001","shared":true},{"id":"ASM-002","statement":"各节点质量事件独立，批内率恒定","source":"A-002","shared":true},{"id":"ASM-003","statement":"拆解不损件，回收件同分布免购复用","source":"A-003","shared":true},{"id":"ASM-004","statement":"稳态期望决策，不计产能库存","source":"A-004","shared":true},{"id":"ASM-005","statement":"图1判读：配件1-6两两配对，加7、8成成品","source":"A-005","shared":false},{"id":"ASM-006","statement":"退回全回流步骤3，每次一记调换损失","source":"A-006","shared":true},{"id":"ASM-007","statement":"区间最不利maximin稳健准则","source":"A-007","shared":false},{"id":"ASM-008","statement":"检测无误检无漏检","source":"A-008","shared":true}],"equations":[{"id":"EQ-BINOM-TAIL","statement":"P(X>=k|p)=sum_{j>=k} C(n,j) p^j (1-p)^(n-j)","meaning":"二项尾概率","shared":true},{"id":"EQ-REJECT-RULE","statement":"拒收域X>=k_n，k_n=min{k:P_p0(X>=k)<=0.05}","meaning":"95%信度拒收规则","shared":false},{"id":"EQ-ACCEPT-RULE","statement":"接收域X<=k_n，k_n=max{k:P_p0(X<=k)<=0.10}","meaning":"90%信度接收规则","shared":false},{"id":"EQ-NMIN","statement":"n*=min n s.t.判定域非空，可加功效约束","meaning":"最少检测次数方案","shared":false},{"id":"EQ-CP-CI","statement":"[p_L,p_U]=Beta逆分位数(x,n-x+1)","meaning":"CP精确置信区间","shared":true},{"id":"EQ-QEFF","statement":"q_i=(1-x_i)*p_i","meaning":"检测下有效次品率","shared":true},{"id":"EQ-PF","statement":"p_f=1-(1-q_1)(1-q_2)(1-p_a)","meaning":"全口径输出次品率","shared":true},{"id":"EQ-COST","statement":"A_i=x_i(c_i+d_i)/(1-p_i)+(1-x_i)c_i","meaning":"单位合格件成本","shared":true},{"id":"EQ-PROFIT-P2","statement":"pi=B(x)/(1-rho(x))，renewal不动点","meaning":"问题2单位期望利润","shared":false},{"id":"EQ-RECURSE-P3","statement":"F_v按拓扑序递归，次品率沿DAG传播","meaning":"网络节点期望递归","shared":false},{"id":"EQ-MAXIMIN","statement":"x*=argmax_x min_{p∈区间} pi(x,p)","meaning":"maximin稳健决策","shared":false},{"id":"EQ-FLIP","statement":"n*=min n s.t.前二策略利润带分离","meaning":"决策翻转临界样本量","shared":false}],"model_specs":[{"id":"MS-Q1","name":"抽样检验方案优化模型","problem_refs":["R-Q1"],"assumption_refs":["ASM-001","ASM-008"],"equation_refs":["EQ-BINOM-TAIL","EQ-REJECT-RULE","EQ-ACCEPT-RULE","EQ-NMIN","EQ-CP-CI"],"symbol_refs":["SYM-P0","SYM-GAMMA","SYM-N","SYM-K","SYM-X"],"objective":"min n s.t.信度约束","decision_vars":"(n,k)"},{"id":"MS-Q2","name":"四级检测拆解决策期望利润模型","problem_refs":["R-Q2"],"assumption_refs":["ASM-002","ASM-003","ASM-004","ASM-006","ASM-008"],"equation_refs":["EQ-QEFF","EQ-PF","EQ-COST","EQ-PROFIT-P2"],"symbol_refs":["SYM-PI","SYM-PA","SYM-QI","SYM-PF","SYM-XV","SYM-YV","SYM-CI","SYM-DI","SYM-CA","SYM-S","SYM-L","SYM-DD","SYM-PROFIT","SYM-RHO"],"objective":"max 单位期望利润","decision_vars":"x1,x2,x3,x4∈{0,1}"},{"id":"MS-Q3","name":"装配网络递归决策模型","problem_refs":["R-Q3"],"assumption_refs":["ASM-002","ASM-003","ASM-004","ASM-005","ASM-006","ASM-008"],"equation_refs":["EQ-QEFF","EQ-PF","EQ-COST","EQ-RECURSE-P3"],"symbol_refs":["SYM-PI","SYM-PA","SYM-QI","SYM-PF","SYM-XV","SYM-YV","SYM-CI","SYM-DI","SYM-CA","SYM-S","SYM-L","SYM-DD","SYM-PROFIT","SYM-RHO"],"objective":"max 单位期望利润","decision_vars":"12检测+4拆解，0-1"},{"id":"MS-Q4","name":"次品率区间稳健再决策模型","problem_refs":["R-Q4"],"assumption_refs":["ASM-001","ASM-002","ASM-004","ASM-007","ASM-008"],"equation_refs":["EQ-BINOM-TAIL","EQ-CP-CI","EQ-MAXIMIN","EQ-FLIP"],"symbol_refs":["SYM-P0","SYM-GAMMA","SYM-N","SYM-INT","SYM-PROFIT","SYM-XV","SYM-YV"],"objective":"maximin 区间利润下界","decision_vars":"同Q2与Q3决策向量"}]}