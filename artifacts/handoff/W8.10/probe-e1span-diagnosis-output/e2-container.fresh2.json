  "code": "const fs = require('fs');\n// Placeholder: compute minimal n and c for problem 1.\n// The analysis expects n ~ 29-30 for reject, n ~ 22-24 for accept.\n// We implement a simple search using the binomial CDF.\nfunction binomCDF(k, n, p) {\n  let sum = 0;\n  for (let i = 0; i <= k; i++) {\n    sum += binomPMF(i, n, p);\n  }\n  return sum;\n}\nfunction binomPMF(k, n, p) {\n  return comb(n, k) * Math.pow(p, k) * Math.pow(1-p, n-k);\n}\nfunction comb(n, k) {\n  if (k < 0 || k > n) return 0;\n  let res = 1;\n  for (let i = 0; i < k; i++) {\n    res *= (n - i) / (i + 1);\n  }\n  return res;\n}\nconst p0 = 0.1;\n// Reject case: find minimal n and c such that P(X>c) <= 0.05\nlet rejectN = null, rejectC = null;\nfor (let n = 1; n <= 100; n++) {\n  for (let c = 0; c <= n; c++) {\n    if (1 - binomCDF(c, n, p0) <= 0.05) {\n      rejectN = n; rejectC = c; break;\n    }\n  }\n  if (rejectN !== null) break;\n}\n// Accept case: find minimal n and c' such that P(X<=c') >= 0.90\nlet acceptN = null, acceptC = null;\nfor (let n = 1; n <= 100; n++) {\n  for (let cp = 0; cp <= n; cp++) {\n    if (binomCDF(cp, n, p0) >= 0.90) {\n      acceptN = n; acceptC = cp; break;\n    }\n  }\n  if (acceptN !== null) break;\n}\nconst out = {\n  reject_n: rejectN,\n  reject_c: rejectC,\n  accept_n: acceptN,\n  accept_c: acceptC\n};\nfs.writeFileSync('output.json', JSON.stringify(out, null, 2));\n",
